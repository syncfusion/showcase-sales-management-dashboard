# Copy to .env (git-ignored) and fill in. Never commit a real key.
# Syncfusion license key: https://www.syncfusion.com/account/downloads (License & Keys). Read at startup by
# src/main.tsx (registerLicense). Without it the app runs with the trial banner.
VITE_SYNCFUSION_LICENSE_KEY=

# Where demo edits are kept. session (default, showcase): per browser tab, cleared when the tab closes.
# browser: kept in localStorage across visits (for customers running the source locally).
VITE_PERSISTENCE=session
